{
  "version": 1,
  "description": "Regras semânticas do Vitrine Prática. Mantém produtos completos e bloqueia peças, refis, capas e acessórios que não representam o item principal pesquisado.",
  "rules": {
    "caixa organizadora": {"require_groups": [["caixa", "cesto", "organizador"]], "block_phrases": ["capa para caixa", "adesivo", "etiqueta avulsa", "rodinha avulsa", "peca", "peça"]},
    "sapateira organizadora": {"require_groups": [["sapateira"]], "block_phrases": ["capa para sapateira", "capa sapateira", "conector", "peca", "peça", "refil"]},
    "organizador banheiro": {"require_groups": [["organizador", "suporte", "prateleira"], ["banheiro", "shampoo", "sabonete", "barbear"]], "block_phrases": ["adesivo avulso", "fita avulsa", "parafuso", "peca", "peça"]},
    "fritadeira eletrica": {"require_groups": [["fritadeira", "air fryer"], ["eletrica", "elétrica", "sem oleo", "sem óleo", "1500w", "1400w", "127v", "220v"]], "block_phrases": ["forma air fryer", "forma para air fryer", "cesto air fryer", "cesto para air fryer", "papel air fryer", "forro air fryer", "tapete air fryer", "spray limpa air fryer", "limpa air fryer", "botao air fryer", "botão air fryer", "resistencia air fryer", "resistência air fryer", "peca air fryer", "peça air fryer", "acessorio air fryer", "acessório air fryer"]},
    "mixer eletrico": {"require_groups": [["mixer"], ["eletrico", "elétrico", "portatil", "portátil", "mao", "mão"]], "block_phrases": ["torneira", "misturador de agua", "haste avulsa", "batedor avulso", "peca para mixer", "peça para mixer", "acessorio para mixer", "acessório para mixer"]},
    "escorredor de loucas": {"require_groups": [["escorredor"], ["louca", "louças", "prato", "pratos"]], "block_phrases": ["tapete escorredor", "tapete para louca", "refil", "peca", "peça"]},
    "smartwatch": {"require_groups": [["smartwatch", "relogio inteligente", "relógio inteligente"]], "block_phrases": ["pulseira para smartwatch", "pulseira smartwatch", "pelicula smartwatch", "película smartwatch", "capa smartwatch", "case smartwatch", "carregador smartwatch", "cabo smartwatch", "protetor smartwatch"]},
    "fone bluetooth": {"require_groups": [["fone", "headphone", "earbuds"], ["bluetooth", "sem fio", "wireless"]], "block_phrases": ["capa para fone", "case para fone", "estojo para fone", "almofada para fone", "cabo para fone", "adaptador para fone", "ponteira para fone"]},
    "carregador usb c": {"require_groups": [["carregador", "fonte"], ["usb c", "type c", "tipo c"]], "block_phrases": ["somente cabo", "cabo avulso", "cabo usb c", "cabo type c", "cabo tipo c", "cabo de carregador", "cabo carregador", "cabo de carga", "cabo 3 em 1", "adaptador otg"]},
    "secador de cabelo": {"require_groups": [["secador"], ["cabelo", "cabelos"]], "block_phrases": ["difusor", "bico para secador", "bico secador", "suporte para secador", "resistencia secador", "resistência secador", "acessorio secador", "acessório secador", "peca secador", "peça secador"]},
    "aparador de pelos": {"require_groups": [["aparador"], ["pelos", "barba", "corpo", "cabelo"]], "block_phrases": ["lamina para aparador", "lâmina para aparador", "pente para aparador", "cabeca aparador", "cabeça aparador", "peca aparador", "peça aparador"]},
    "escova secadora": {"require_groups": [["escova"], ["secadora", "secador", "modeladora", "rotativa"]], "block_phrases": ["refil escova", "cabeca escova", "cabeça escova", "cerdas reposicao", "cerdas reposição", "peca", "peça"]},
    "garrafa termica": {"require_groups": [["garrafa"], ["termica", "térmica", "inox", "vacuo", "vácuo"]], "block_phrases": ["adaptador", "tampa para garrafa", "tampa garrafa", "canudo para garrafa", "bico para garrafa", "capa para garrafa", "alca garrafa", "alça garrafa", "peca", "peça"]},
    "mochila": {"require_groups": [["mochila"]], "block_phrases": ["capa de chuva para mochila", "capa para mochila", "alca para mochila", "alça para mochila", "fivela mochila", "zíper mochila", "ziper mochila"]},
    "ventilador portatil": {"require_groups": [["ventilador"], ["portatil", "portátil", "mesa", "usb", "recarregavel", "recarregável"]], "block_phrases": ["helice ventilador", "hélice ventilador", "grade ventilador", "motor ventilador", "capacitor ventilador", "peca ventilador", "peça ventilador"]}
  }
}
