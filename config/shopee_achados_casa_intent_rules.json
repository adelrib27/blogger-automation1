{
  "version": 4,
  "description": "Regras semânticas específicas do Achados para Casa para impedir acessórios, refis e falsos positivos na vitrine Shopee.",
  "rules": {
    "caixa organizadora": {"require_groups": [["caixa"], ["organizadora", "organizador", "organizacao"]], "block_phrases": ["caixa de som", "caixa acustica", "caixa para ferramenta"]},
    "sapateira organizadora": {"require_groups": [["sapateira"]], "block_phrases": ["capa para sapateira", "peca para sapateira"]},
    "cabideiro": {"require_groups": [["cabideiro", "arara de roupas", "arara roupas"]], "block_phrases": ["cabide avulso", "gancho avulso"]},
    "organizador banheiro": {"require_groups": [["organizador", "prateleira", "suporte", "porta ", "carrinho", "cesto", "dispenser", "dispensador"], ["banheiro", "lavabo", "shampoo", "sabonete", "barbeador", "escova de dente"]], "block_phrases": ["brinquedo", "fantasia", "decoracao de festa"]},
    "air fryer": {"require_groups": [["air fryer", "airfryer", "fritadeira sem oleo", "fritadeira eletrica"]], "block_phrases": ["adaptador de tomada", "forma de silicone", "formas de silicone", "papel para air fryer", "tapete de silicone", "cesto para air fryer", "acessorio para air fryer", "capa para air fryer"]},
    "escorredor de loucas": {"require_groups": [["escorredor"], ["louca", "loucas", "prato", "pratos", "talher", "talheres", "copo", "copos"]], "block_phrases": ["tapete escorredor", "peca para escorredor", "escorredor massa", "escorredor macarrao", "escorredor arroz", "escorredor legumes"]},
    "organizador cozinha": {"require_groups": [["organizador", "prateleira", "suporte", "porta ", "carrinho", "cesto", "pote", "rack", "dispenser", "dispensador", "escorredor"], ["cozinha", "mantimento", "tempero", "papel toalha", "louca", "cafe", "talher", "geladeira", "pia"]], "block_phrases": ["cesto de roupa", "cesto de roupas", "brinquedos", "organizador de maquiagem"]},
    "mixer eletrico": {"require_groups": [["mixer"]], "block_phrases": ["haste para mixer", "copo para mixer", "lamina para mixer", "acessorio para mixer"]},
    "aspirador de po": {"require_groups": [["aspirador"]], "block_phrases": ["filtro para aspirador", "saco para aspirador", "mangueira para aspirador", "bico para aspirador", "escova para aspirador", "peca para aspirador"]},
    "mop giratorio": {"require_groups": [["mop"], ["giratorio", "centrifuga", "balde"]], "block_phrases": ["cabo para mop", "cabo mop", "refil para mop", "refil mop", "refil", "reposicao para mop", "reposição para mop"]},
    "cesto de roupas": {"require_groups": [["cesto"], ["roupa", "roupas", "lavanderia"]], "block_phrases": ["miniatura", "chaveiro"]},
    "varal de chao": {"require_groups": [["varal"], ["chao", "piso", "portatil", "dobravel"]], "block_phrases": ["corda para varal", "prendedor de roupa", "capa para varal", "peca para varal"]},
    "luminaria": {"require_groups": [["luminaria", "abajur", "plafon", "lampada led", "luz led"]], "block_phrases": ["fita led", "adesivo", "miniatura"]},
    "cortina blackout": {"require_groups": [["cortina"], ["blackout", "blecaute"]], "block_phrases": ["tecido para cortina", "varao para cortina", "gancho para cortina"]},
    "tapete sala": {"require_groups": [["tapete"], ["sala", "quarto", "corredor", "passadeira"]], "block_phrases": ["mouse pad", "tapete para carro", "tapete automotivo"]},
    "jogo de cama": {"require_groups": [["jogo de cama", "lencol", "lençol"], ["casal", "queen", "king", "solteiro", "berco", "berço"]], "block_phrases": ["cama pet", "roupa de boneca"]},
    "ventilador de teto": {"require_groups": [["ventilador"], ["teto"]], "block_phrases": ["carimbo", "impressao 3d", "confeitaria", "molde", "chaveiro", "adesivo", "topper", "ventoinha", "motor ventilador", "resistencia ventilador", "escova", "limpador", "espanador", "capa para ventilador", "grade para ventilador", "helice avulsa", "capacitor", "suporte para ventilador", "peca para ventilador", "cabo para ventilador"]},
    "mini umidificador usb": {"require_groups": [["umidificador", "humidificador"], ["usb", "mini", "portatil", "portátil", "recarregavel", "recarregável"]], "block_phrases": ["essencia", "essência", "essencias", "essências", "kit essencias", "kit de essencias", "oleo essencial", "óleo essencial", "refil", "filtro", "pavio avulso", "algodao avulso", "algodão avulso"]},
    "climatizador": {"require_groups": [["climatizador", "refrigerador de ar", "mini ar condicionado"]], "block_phrases": ["filtro para climatizador", "peca para climatizador", "peça para climatizador", "controle para climatizador"]},
    "ventilador de mesa": {"require_groups": [["ventilador"], ["mesa"]], "block_phrases": ["carimbo", "impressao 3d", "confeitaria", "molde", "chaveiro", "adesivo", "topper", "ventoinha", "motor ventilador", "resistencia ventilador", "escova", "limpador", "espanador", "capa para ventilador", "grade para ventilador", "helice avulsa", "capacitor", "suporte para ventilador", "peca para ventilador", "cabo para ventilador"]},
    "aparador de pelos": {"require_groups": [["aparador de pelos", "aparador pelos", "maquina de barbear", "barbeador eletrico"]], "block_phrases": ["papa bolinhas", "tira pelos de roupas", "removedor de pelos de roupas", "removedor de pelo de roupa"]},
    "oculos uv400": {"require_groups": [["oculos"], ["uv400", "protecao uv"]], "block_phrases": ["estojo para oculos", "cordao para oculos", "lente avulsa", "armacao sem lente"]}
  }
}
