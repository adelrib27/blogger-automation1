{
  "version": 2,
  "description": "Regras semânticas específicas do Vida Pet Prática. A seleção final também passa por bloqueio global de saúde/veterinária e pelo Blogger Policy Guard.",
  "rules": {
    "peitoral cachorro": {"require_groups": [["peitoral"], ["cachorro", "cão", "cao", "pet"]], "block_phrases": ["peitoral humano", "bebê", "bebe", "fantasia"]},
    "guia cachorro": {"require_groups": [["guia"], ["cachorro", "cão", "cao", "pet"]], "block_phrases": ["guia turístico", "guia turistico", "livro", "manual", "cabo avulso", "mosquetão avulso", "mosquetao avulso"]},
    "caixa transporte pet": {"require_groups": [["caixa", "kennel"], ["transporte", "transportadora"], ["pet", "cachorro", "cão", "cao", "gato"]], "block_phrases": ["caixa organizadora", "caixa de som", "miniatura", "brinquedo"]},
    "bolsa transporte pet": {"require_groups": [["bolsa", "mochila"], ["transporte", "transportadora"], ["pet", "cachorro", "cão", "cao", "gato"]], "block_phrases": ["bolsa feminina", "bolsa maternidade", "mochila escolar", "miniatura"]},
    "comedouro pet inox": {"require_groups": [["comedouro"], ["inox", "inoxidável", "inoxidavel"]], "block_phrases": ["suporte avulso", "base avulsa", "tapete"]},
    "bebedouro pet automatico": {"require_groups": [["bebedouro", "fonte"], ["automático", "automatico", "elétrico", "eletrico"], ["pet", "cachorro", "cão", "cao", "gato"]], "block_phrases": ["filtro avulso", "bomba avulsa", "motor avulso", "fonte de alimentação", "fonte de alimentacao"]},
    "tapete comedouro pet": {"require_groups": [["tapete"], ["comedouro", "alimentação", "alimentacao", "ração", "racao"], ["pet", "cachorro", "cão", "cao", "gato"]], "block_phrases": ["tapete higiênico", "tapete higienico", "tapete banheiro"]},
    "pote racao hermetico pet": {"require_groups": [["pote", "recipiente", "porta ração", "porta racao"], ["ração", "racao"], ["hermético", "hermetico", "vedado", "vedação", "vedacao"]], "block_phrases": ["comedouro", "dosador automático", "dosador automatico"]},
    "tapete higienico cachorro": {"require_groups": [["tapete"], ["higiênico", "higienico"], ["cachorro", "cão", "cao", "pet"]], "block_phrases": ["fralda", "absorvente humano"]},
    "coletor fezes cachorro": {"require_groups": [["coletor", "cata caca", "cata-caca", "porta saquinho"], ["fezes", "caca", "cocô", "coco", "saquinho"], ["cachorro", "cão", "cao", "pet"]], "block_phrases": ["refil saquinho", "saco refil", "pá avulsa", "pa avulsa"]},
    "escova removedora pelos pet": {"require_groups": [["escova", "removedor"], ["pelo", "pelos"], ["pet", "cachorro", "cão", "cao", "gato"]], "block_phrases": ["escova secadora", "cabelo humano", "chapinha", "barbeador"]},
    "organizador acessorios pet": {"require_groups": [["organizador", "porta acessórios", "porta acessorios"], ["pet", "cachorro", "cão", "cao", "gato"]], "block_phrases": ["maquiagem", "cozinha", "ferramentas"]},
    "cama cachorro lavavel": {"require_groups": [["cama", "colchonete"], ["cachorro", "cão", "cao", "pet"]], "block_phrases": ["capa avulsa", "enchimento avulso", "cama infantil", "boneca"]},
    "cama gato": {"require_groups": [["cama", "berço", "berco"], ["gato", "felino", "pet"]], "block_phrases": ["capa avulsa", "cama infantil", "boneca"]},
    "manta pet": {"require_groups": [["manta", "cobertor"], ["pet", "cachorro", "cão", "cao", "gato"]], "block_phrases": ["manta sofá", "manta sofa", "manta casal", "manta bebê", "manta bebe"]},
    "toca gato": {"require_groups": [["toca", "iglu", "cabana"], ["gato", "felino", "pet"]], "block_phrases": ["toca infantil", "barraca infantil", "casa boneca"]},
    "brinquedo mordedor cachorro": {"require_groups": [["mordedor"], ["cachorro", "cão", "cao", "pet"]], "block_phrases": ["mordedor bebê", "mordedor bebe", "osso natural", "osso bovino", "petisco", "comestível", "comestivel"]},
    "bola interativa pet": {"require_groups": [["bola"], ["interativa", "interativo"], ["pet", "cachorro", "cão", "cao", "gato"]], "block_phrases": ["futebol", "basquete", "bola infantil", "petisco incluso"]},
    "varinha gato brinquedo": {"require_groups": [["varinha"], ["gato", "felino"], ["brinquedo", "interativa", "interativo"]], "block_phrases": ["vara pesca", "pesca", "varinha mágica", "varinha magica"]},
    "arranhador gato": {"require_groups": [["arranhador"], ["gato", "felino", "pet"]], "block_phrases": ["refil sisal", "sisal avulso", "poste reposição", "poste reposicao"]}
  }
}
