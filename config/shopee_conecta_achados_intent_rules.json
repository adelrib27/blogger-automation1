{
  "version": 1,
  "description": "Regras semânticas específicas do Conecta Achados para impedir acessórios, peças e falsos positivos na vitrine Shopee.",
  "rules": {
    "carrinho organizador": {"require_groups": [["carrinho"], ["organizador", "multiuso", "prateleira"]], "block_phrases": ["brinquedo", "miniatura", "carrinho de bebe", "carrinho controle remoto"]},
    "caixa organizadora": {"require_groups": [["caixa"], ["organizadora", "organizador", "organizacao"]], "block_phrases": ["caixa de som", "caixa acustica", "caixa para ferramenta"]},
    "sapateira organizadora": {"require_groups": [["sapateira"]], "block_phrases": ["capa para sapateira", "peca para sapateira"]},
    "organizador banheiro": {"require_groups": [["organizador", "prateleira", "suporte", "porta ", "carrinho", "cesto", "dispenser", "dispensador"], ["banheiro", "lavabo", "shampoo", "sabonete", "barbeador", "escova de dente"]], "block_phrases": ["brinquedo", "fantasia", "decoracao de festa"]},

    "fritadeira eletrica": {"require_groups": [["fritadeira", "air fryer", "airfryer"], ["eletrica", "sem oleo", "air fryer", "airfryer"]], "block_phrases": ["forma de silicone", "papel para air fryer", "cesto para air fryer", "capa para air fryer", "grade para air fryer", "resistencia", "puxador", "botao", "acessorio"]},
    "escorredor de loucas": {"require_groups": [["escorredor"], ["louca", "loucas", "prato", "pratos", "talher", "talheres", "copo", "copos"]], "block_phrases": ["tapete escorredor", "peca para escorredor", "escorredor massa", "escorredor macarrao", "escorredor arroz", "escorredor legumes"]},
    "mixer eletrico": {"require_groups": [["mixer"]], "block_phrases": ["haste para mixer", "copo para mixer", "lamina para mixer", "acessorio para mixer", "peca para mixer"]},
    "organizador cozinha": {"require_groups": [["organizador", "prateleira", "suporte", "porta ", "carrinho", "cesto", "pote", "rack", "dispenser", "dispensador", "escorredor"], ["cozinha", "mantimento", "tempero", "papel toalha", "louca", "cafe", "talher", "geladeira", "pia"]], "block_phrases": ["cesto de roupa", "cesto de roupas", "brinquedos", "organizador de maquiagem"]},

    "fone bluetooth": {"require_groups": [["fone", "headphone", "earbuds"], ["bluetooth", "sem fio", "wireless"]], "block_phrases": ["capa para fone", "case para fone", "estojo para fone", "almofada para fone", "cabo para fone"]},
    "smartwatch": {"require_groups": [["smartwatch", "relogio inteligente"]], "block_phrases": ["pulseira para smartwatch", "pelicula para smartwatch", "carregador para smartwatch", "capa para smartwatch", "bracelete"]},
    "carregador usb c": {"require_groups": [["carregador", "fonte"], ["usb c", "type c", "pd", "power delivery"]], "block_phrases": ["cabo usb c", "cabo type c", "adaptador de cabo", "conector avulso"]},
    "caixa de som bluetooth": {"require_groups": [["caixa de som", "speaker"], ["bluetooth", "sem fio", "wireless"]], "block_phrases": ["capa para caixa de som", "suporte para caixa de som", "placa para caixa de som", "bateria para caixa de som"]},

    "aparador de pelos": {"require_groups": [["aparador de pelos", "aparador pelos", "maquina de barbear", "barbeador eletrico"]], "block_phrases": ["papa bolinhas", "tira pelos de roupas", "removedor de pelos de roupas", "removedor de pelo de roupa", "lamina de reposicao"]},
    "escova secadora": {"require_groups": [["escova"], ["secadora", "secador", "hot air", "ar quente"]], "block_phrases": ["refil", "capa para escova", "suporte para escova", "peca para escova"]},
    "secador de cabelo": {"require_groups": [["secador"], ["cabelo", "cabelos"]], "block_phrases": ["difusor para secador", "bico para secador", "suporte para secador", "resistencia para secador", "cabo para secador"]},
    "chapinha cabelo": {"require_groups": [["chapinha", "prancha"], ["cabelo", "cabelos", "alisadora", "alisador"]], "block_phrases": ["capa para chapinha", "suporte para chapinha", "bolsa para chapinha"]},

    "mochila notebook": {"require_groups": [["mochila"], ["notebook", "laptop", "executiva", "trabalho"]], "block_phrases": ["capa para notebook", "bolsa apenas para notebook", "adesivo para mochila"]},
    "garrafa termica": {"require_groups": [["garrafa"], ["termica", "térmica"]], "block_phrases": ["tampa para garrafa", "vedacao para garrafa", "anel de vedacao", "canudo avulso"]},
    "lanterna recarregavel": {"require_groups": [["lanterna"], ["recarregavel", "recarregável", "usb"]], "block_phrases": ["suporte para lanterna", "bateria para lanterna", "capa para lanterna", "lampada para lanterna"]},
    "guarda chuva automatico": {"require_groups": [["guarda chuva", "guarda-chuva"], ["automatico", "automático", "abre fecha", "abertura automatica", "abertura automática"]], "block_phrases": ["capa para guarda chuva", "suporte para guarda chuva", "miniatura", "chaveiro"]}
  }
}
