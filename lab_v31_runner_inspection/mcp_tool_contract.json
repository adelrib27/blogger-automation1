{
  "schema": "v31-mcp-plugin-contract-proposal/v1",
  "status": "LAB_ONLY_NOT_DEPLOYED",
  "enabled_by_default": false,
  "feature_gate": "BLOGGER_V31_SOURCE_INSPECTION_ENABLED=true",
  "required_existing_tools": [
    "health",
    "audit",
    "preflight_blog",
    "create_blog",
    "preflight_settings",
    "configure_settings",
    "adopt_model_v31_exact",
    "provision_new_blog_v31"
