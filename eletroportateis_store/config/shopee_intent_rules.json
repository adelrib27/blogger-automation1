{
  "version": 1,
  "description": "Regras semânticas do Eletroportáteis na Cozinha. Exige aparelhos completos e bloqueia peças, acessórios, reposições e produtos não pertencentes à cozinha.",
  "rules": {
    "fritadeira eletrica": {"require_groups": [["fritadeira", "air fryer"], ["eletrica", "elétrica", "w", "127v", "220v", "bivolt", "litros", "l"]], "block_phrases": ["forma air fryer", "forma para air fryer", "cesto air fryer", "cesto para air fryer", "papel air fryer", "forro air fryer", "tapete air fryer", "spray limpa air fryer", "botao air fryer", "botão air fryer", "resistencia air fryer", "resistência air fryer", "peca air fryer", "peça air fryer", "acessorio air fryer", "acessório air fryer", "reposicao", "reposição"]},
    "air fryer": {"require_groups": [["air fryer", "fritadeira"], ["w", "127v", "220v", "bivolt", "litros", "l"]], "block_phrases": ["forma", "cesto", "papel", "forro", "tapete", "spray", "botao", "botão", "resistencia", "resistência", "peca", "peça", "acessorio", "acessório", "reposicao", "reposição"]},
    "air fryer forno": {"require_groups": [["air fryer", "fritadeira"], ["forno", "oven"], ["w", "127v", "220v", "bivolt", "litros", "l"]], "block_phrases": ["forma", "cesto", "papel", "forro", "tapete", "spray", "peca", "peça", "acessorio", "acessório", "reposicao", "reposição"]},
    "liquidificador": {"require_groups": [["liquidificador"]], "block_phrases": ["copo para liquidificador", "copo liquidificador", "jarra para liquidificador", "lamina", "lâmina", "tampa", "motor", "acoplamento", "peca", "peça", "acessorio", "acessório", "reposicao", "reposição"]},
    "mixer eletrico": {"require_groups": [["mixer"], ["eletrico", "elétrico", "portatil", "portátil", "mao", "mão", "w", "bivolt", "127v", "220v"]], "block_phrases": ["haste avulsa", "batedor avulso", "peca", "peça", "acessorio", "acessório", "reposicao", "reposição"]},
    "mixer 3 em 1": {"require_groups": [["mixer"], ["3 em 1", "3x1", "3 in 1"]], "block_phrases": ["haste avulsa", "batedor avulso", "peca", "peça", "acessorio", "acessório", "reposicao", "reposição"]},
    "processador de alimentos": {"require_groups": [["processador", "multiprocessador"], ["alimento", "alimentos", "cozinha"]], "block_phrases": ["intel", "amd", "cpu", "computador", "copo para", "jarra para", "lamina", "lâmina", "cone", "disco avulso", "eixo", "engrenagem", "tampa", "peca", "peça", "acessorio", "acessório", "reposicao", "reposição"]},
    "multiprocessador": {"require_groups": [["multiprocessador"]], "block_phrases": ["intel", "amd", "cpu", "computador", "copo para", "jarra para", "lamina", "lâmina", "cone", "disco avulso", "eixo", "engrenagem", "tampa", "peca", "peça", "acessorio", "acessório", "reposicao", "reposição"]},
    "mini processador eletrico": {"require_groups": [["processador"], ["mini", "compacto"], ["eletrico", "elétrico", "cozinha", "alimentos"]], "block_phrases": ["intel", "amd", "cpu", "computador", "lamina avulsa", "lâmina avulsa", "cone", "disco avulso", "eixo", "engrenagem", "tampa avulsa", "peca", "peça", "acessorio", "acessório", "reposicao", "reposição"]},
    "batedeira planetaria": {"require_groups": [["batedeira"], ["planetaria", "planetária"], ["w", "127v", "220v", "bivolt", "velocidade", "velocidades"]], "block_phrases": ["batedor avulso", "tigela avulsa", "gancho avulso", "peca", "peça", "acessorio", "acessório", "reposicao", "reposição"]},
    "batedeira eletrica": {"require_groups": [["batedeira"], ["eletrica", "elétrica", "w", "127v", "220v", "bivolt"]], "block_phrases": ["batedor avulso", "tigela avulsa", "gancho avulso", "peca", "peça", "acessorio", "acessório", "reposicao", "reposição"]},
    "batedeira portatil": {"require_groups": [["batedeira"], ["portatil", "portátil", "manual", "mao", "mão"], ["eletrica", "elétrica", "w", "127v", "220v", "bivolt"]], "block_phrases": ["batedor avulso", "peca", "peça", "acessorio", "acessório", "reposicao", "reposição"]},
    "cafeteira eletrica": {"require_groups": [["cafeteira"], ["eletrica", "elétrica", "w", "127v", "220v", "bivolt", "xicaras", "xícaras"]], "block_phrases": ["filtro avulso", "jarra avulsa", "porta filtro", "peca", "peça", "acessorio", "acessório", "capsula", "cápsula", "cafe", "café em graos", "café em grãos"]},
    "sanduicheira eletrica": {"require_groups": [["sanduicheira", "grill"], ["eletrica", "elétrica", "w", "127v", "220v", "bivolt"]], "block_phrases": ["placa avulsa", "chapa avulsa", "peca", "peça", "acessorio", "acessório", "reposicao", "reposição"]},
    "chaleira eletrica": {"require_groups": [["chaleira"], ["eletrica", "elétrica", "w", "127v", "220v", "bivolt", "litros", "l"]], "block_phrases": ["base avulsa", "tampa avulsa", "filtro avulso", "peca", "peça", "acessorio", "acessório", "reposicao", "reposição"]}
  }
}
