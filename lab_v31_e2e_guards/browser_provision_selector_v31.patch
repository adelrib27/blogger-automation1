+def _wait_new_blog_option(page: Page, *, attempts: int = 10, delay_ms: int = 200) -> Locator | None:
+    """Bounded wait for an existing, visible menu option. Never creates a blog."""
+    for attempt in range(attempts):
+        control = find_new_blog(page)
+        if control is not None:
+            return control
+        if attempt + 1 < attempts:
+            page.wait_for_timeout(delay_ms)
+    return None
+
