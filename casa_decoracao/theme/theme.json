{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "800px",
      "wideSize": "1180px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {"slug":"aqua","name":"Verde água","color":"#19D3C5"},
        {"slug":"aqua-light","name":"Verde água claro","color":"#67F5E9"},
        {"slug":"aqua-deep","name":"Verde água profundo","color":"#0F8279"},
        {"slug":"forest","name":"Verde profundo","color":"#082D2A"},
        {"slug":"ink","name":"Texto","color":"#18221F"},
        {"slug":"mist","name":"Fundo","color":"#F4F7F6"},
        {"slug":"white","name":"Branco","color":"#FFFFFF"}
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {"slug":"system","name":"Sistema","fontFamily":"-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Arial,sans-serif"}
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#F4F7F6",
      "text": "#18221F"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "color": {"text":"#142520"},
        "typography": {"fontWeight":"800","lineHeight":"1.15"}
      },
      "link": {
        "color": {"text":"#0F8279"},
        "typography": {"textDecoration":"none"},
        ":hover": {"color":{"text":"#0B5E57"}}
      },
      "button": {
        "color": {"background":"#19D3C5","text":"#052F2C"},
        "border": {"radius":"10px"},
        "typography": {"fontWeight":"800"}
      }
    },
    "blocks": {
      "core/post-title": {
        "elements": {"link":{"color":{"text":"#18221F"}}}
      },
      "core/query-pagination": {
        "color": {"text":"#0F8279"}
      }
    }
  }
}
