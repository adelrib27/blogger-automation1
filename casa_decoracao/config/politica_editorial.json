{
  "version": 3,
  "project": "Casa e Decoração",
  "site_url": "https://casaedecoracao.radartechbr.com.br/",
  "timezone": "America/Recife",
  "automation": {
    "mode": "autonomous",
    "posts_per_day": 3,
    "posts_per_run": 1,
    "hard_daily_cap": 3,
    "category_rotation_required": true,
    "rotation_policy": "não repetir categoria enquanto houver outra categoria oficial ainda pendente no ciclo",
    "category_cycle_target_days": 3,
    "generation_model": "@cf/qwen/qwen3-30b-a3b-fp8",
    "featured_image_source": "Shopee imageUrl do produto real"
  },
  "allowed_categories": [
    "Decoração",
    "Organização",
    "Sala",
    "Quarto",
    "Cozinha",
    "Banheiro",
    "Área Externa",
    "Cama, Mesa e Banho"
  ],
  "editorial_rules": {
    "single_editorial_title": true,
    "commercial_title_only_in_cta": true,
    "minimum_words": 550,
    "target_words": "600-900",
    "minimum_h2": 5,
    "two_contextual_ctas": true,
    "affiliate_rel": "nofollow sponsored",
    "require_affiliate_disclosure": true,
    "no_fake_testing": true,
    "no_invented_specs": true,
    "no_unverified_price_stock_discount": true,
    "no_medical_or_therapeutic_claims": true,
    "no_dangerous_electrical_gas_or_chemical_steps": true,
    "require_internal_category_link": true,
    "require_real_product_image_in_cta": true,
    "require_featured_product_image_before_publish": true,
    "fail_closed": true
  },
  "publication": {
    "wordpress_status": "publish",
    "create_as_draft_first": true,
    "upload_featured_image_before_publish": true,
    "verify_featured_media_before_publish_confirmation": true,
    "dedupe_by_shopee_item_id": true,
    "dedupe_by_product_similarity": true,
    "history_path": "casa_decoracao/data/publication_history.json",
    "rotation_path": "casa_decoracao/data/category_rotation.json",
    "queue_path": "casa_decoracao/data/editorial_queue.json"
  }
}
