    "mop giratorio": {"require_groups": [["mop"], ["giratorio", "giratório", "centrifuga", "centrífuga"]], "block_phrases": ["refil avulso", "refil mop", "cabo avulso", "balde avulso", "peca", "peça", "reposicao", "reposição"]},
    "mop spray": {"require_groups": [["mop"], ["spray", "borrifador", "reservatorio", "reservatório"]], "block_phrases": ["refil avulso", "pano avulso", "cabo avulso", "peca", "peça", "reposicao", "reposição"]},
