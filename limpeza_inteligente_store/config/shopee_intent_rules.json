    "aspirador portatil": {"require_groups": [["aspirador"], ["portatil", "portátil", "mao", "mão", "carro", "automotivo"]], "block_phrases": ["filtro", "bico avulso", "mangueira", "peca", "peça", "acessorio", "acessório", "reposicao", "reposição"]},
